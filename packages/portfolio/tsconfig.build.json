{
  "extends": "tsconfig/react-library.json",
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/*.test.js",
    "**/*.spec.tsx",
    "**/*.spec.ts",
    "**/*.spec.js",
    "**/*.stories.tsx"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "sourceMap": false,
    "module": "esnext",
    "target": "es2020",
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "typeRoots": ["./node_modules/@types", "./src/@types"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false, 
    "skipLibCheck": true,
    "strict": false
  }
}